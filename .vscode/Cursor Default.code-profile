on.previousEditor\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"alt+cmd+right\\\",\\n    \\\"command\\\": \\\"-workbench.action.nextEditor\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+e\\\",\\n    \\\"command\\\": \\\"-actions.findWithSelection\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+o\\\",\\n    \\\"command\\\": \\\"-editor.action.organizeImports\\\",\\n    \\\"when\\\": \\\"editorTextFocus && !editorReadonly && supportedCodeAction =~ /(\\\\\\\\s|^)source\\\\\\\\.organizeImports\\\\\\\\b/\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+e\\\",\\n    \\\"command\\\": \\\"workbench.action.quickOpen\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+up\\\",\\n    \\\"command\\\": \\\"block-travel.jumpUp\\\",\\n    \\\"when\\\": \\\"editorTextFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"alt+up\\\",\\n    \\\"command\\\": \\\"-block-travel.jumpUp\\\",\\n    \\\"when\\\": \\\"editorTextFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+down\\\",\\n    \\\"command\\\": \\\"block-travel.jumpDown\\\",\\n    \\\"when\\\": \\\"editorTextFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"alt+down\\\",\\n    \\\"command\\\": \\\"-block-travel.jumpDown\\\",\\n    \\\"when\\\": \\\"editorTextFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+down\\\",\\n    \\\"command\\\": \\\"block-travel.selectDown\\\",\\n    \\\"when\\\": \\\"editorTextFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+down\\\",\\n    \\\"command\\\": \\\"-block-travel.selectDown\\\",\\n    \\\"when\\\": \\\"editorTextFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+up\\\",\\n    \\\"command\\\": \\\"block-travel.selectUp\\\",\\n    \\\"when\\\": \\\"editorTextFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+up\\\",\\n    \\\"command\\\": \\\"-block-travel.selectUp\\\",\\n    \\\"when\\\": \\\"editorTextFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"alt+cmd+j\\\",\\n    \\\"command\\\": \\\"-liveshare.join\\\",\\n    \\\"when\\\": \\\"liveshare:state != 'Joined' && liveshare:state != 'Shared'\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"alt+cmd+j\\\",\\n    \\\"command\\\": \\\"editor.action.surroundWithSnippet\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+j\\\",\\n    \\\"command\\\": \\\"editor.action.insertSnippet\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+j\\\",\\n    \\\"command\\\": \\\"-workbench.action.togglePanel\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+delete\\\",\\n    \\\"command\\\": \\\"editor.emmet.action.removeTag\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+i\\\",\\n    \\\"command\\\": \\\"composerMode.agent\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+alt+down\\\",\\n    \\\"command\\\": \\\"editor.action.dirtydiff.next\\\",\\n    \\\"when\\\": \\\"editorTextFocus && !textCompareEditorActive\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"alt+f3\\\",\\n    \\\"command\\\": \\\"-editor.action.dirtydiff.next\\\",\\n    \\\"when\\\": \\\"editorTextFocus && !textCompareEditorActive\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+alt+down\\\",\\n    \\\"command\\\": \\\"notebook.diff.action.next\\\",\\n    \\\"when\\\": \\\"activeEditor == 'workbench.editor.notebookTextDiffEditor'\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"alt+f3\\\",\\n    \\\"command\\\": \\\"-notebook.diff.action.next\\\",\\n    \\\"when\\\": \\\"activeEditor == 'workbench.editor.notebookTextDiffEditor'\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+alt+up\\\",\\n    \\\"command\\\": \\\"editor.action.dirtydiff.previous\\\",\\n    \\\"when\\\": \\\"editorTextFocus && !textCompareEditorActive\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+f3\\\",\\n    \\\"command\\\": \\\"-editor.action.dirtydiff.previous\\\",\\n    \\\"when\\\": \\\"editorTextFocus && !textCompareEditorActive\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+alt+up\\\",\\n    \\\"command\\\": \\\"notebook.diff.action.previous\\\",\\n    \\\"when\\\": \\\"activeEditor == 'workbench.editor.notebookTextDiffEditor'\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+alt+f3\\\",\\n    \\\"command\\\": \\\"-notebook.diff.action.previous\\\",\\n    \\\"when\\\": \\\"activeEditor == 'workbench.editor.notebookTextDiffEditor'\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+z\\\",\\n    \\\"command\\\": \\\"-extension.vscode-git-automator.addAndCommitCurrentFile\\\"\\n  },\\n  {\\n    \\\"comment\\\": \\\"Focus the active editor group when the escape key is pressed and no text editor is focused https://stackoverflow.com/questions/55190841/how-can-i-make-vscode-focus-on-the-active-editor-by-hitting-escape\\\",\\n    \\\"key\\\": \\\"escape\\\",\\n    \\\"command\\\": \\\"workbench.action.focusActiveEditorGroup\\\",\\n    \\\"when\\\": \\\"!editorTextFocus\\\"\\n  },\\n  // {\\n  //   \\\"key\\\": \\\"escape\\\",\\n  //   \\\"comment\\\": \\\"TRYYYYYYYYYY to close diff editor on esc\\\",\\n  //   \\\"command\\\": \\\"git.closeAllDiffEditors\\\",\\n  //   \\\"when\\\": \\\"editorFocus\\\"\\n  // },\\n  {\\n    \\\"key\\\": \\\"f4\\\",\\n    \\\"command\\\": \\\"git.openFile\\\",\\n    \\\"when\\\": \\\"config.git.enabled && isInDiffEditor && !git.missing && gitOpenRepositoryCount != '0' && resourceScheme =~ /^git$|^file$/\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+n\\\",\\n    \\\"command\\\": \\\"-workbench.action.files.newUntitledFile\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+n\\\",\\n    \\\"command\\\": \\\"workbench.files.action.createFileFromExplorer\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+cmd+k\\\",\\n    \\\"command\\\": \\\"-editor.action.deleteLines\\\",\\n    \\\"when\\\": \\\"textInputFocus && !editorReadonly\\\"\\n  },\\n\\n  // Focus on changes instead of this input history https://stackoverflow.com/questions/77160922/how-can-i-navigate-and-manipulate-list-views-in-vs-code-using-the-keyboard\\n  {\\n    \\\"key\\\": \\\"up\\\",\\n    \\\"command\\\": \\\"list.focusUp\\\",\\n    \\\"when\\\": \\\"!inputFocus && listFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"down\\\",\\n    \\\"command\\\": \\\"list.focusDown\\\",\\n    \\\"when\\\": \\\"!inputFocus && listFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"home\\\",\\n    \\\"command\\\": \\\"list.focusFirst\\\",\\n    \\\"when\\\": \\\"!inputFocus && listFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"end\\\",\\n    \\\"command\\\": \\\"list.focusLast\\\",\\n    \\\"when\\\": \\\"!inputFocus && listFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"pageup\\\",\\n    \\\"command\\\": \\\"list.focusPageUp\\\",\\n    \\\"when\\\": \\\"!inputFocus && listFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"pagedown\\\",\\n    \\\"command\\\": \\\"list.focusPageDown\\\",\\n    \\\"when\\\": \\\"!inputFocus && listFocus\\\"\\n  },\\n\\n  {\\n    // https://stackoverflow.com/questions/75746413/in-vscode-how-do-i-jump-to-the-results-of-find-in-files-without-using-the-mou\\n    \\\"comment\\\": \\\"When cmd+shift+f - focus on the result when key down\\\",\\n    \\\"key\\\": \\\"down\\\",\\n    \\\"command\\\": \\\"runCommands\\\",\\n    \\\"when\\\": \\\"searchInputBoxFocus\\\",\\n    \\\"args\\\": {\\n      \\\"commands\\\": [\\\"search.action.focusSearchList\\\", \\\"list.focusDown\\\"]\\n    }\\n  },\\n  {\\n    // https://stackoverflow.com/questions/75332910/vscode-shortcut-to-focus-and-navigate-file-in-source-control-view\\n    \\\"comment\\\": \\\"When in changes view - focus on the results\\\",\\n    \\\"key\\\": \\\"down\\\",\\n    \\\"command\\\": \\\"runCommands\\\",\\n    \\\"when\\\": \\\"focusedView == workbench.scm && inputFocus\\\",\\n    \\\"args\\\": {\\n      \\\"commands\\\": [\\n        \\\"list.focusFirst\\\", // focuses the commit message input, as close as you can get\\n        \\\"list.focusDown\\\",\\n        \\\"list.focusDown\\\",\\n        \\\"list.focusDown\\\"\\n      ]\\n    }\\n  },\\n  {\\n    \\\"comment\\\": \\\"In Source Control view, discard Git changes for the selected file(s) when the list (not the input) is focused\\\",\\n    \\\"key\\\": \\\"cmd+alt+z\\\",\\n    \\\"command\\\": \\\"git.clean\\\",\\n    \\\"when\\\": \\\"focusedView == workbench.scm && !